<section class="section not-found page-width">
  <span class="not-found__num" aria-hidden="true">404</span>
  <h1 class="h-section" data-split>{{ 'general.404_title' | t }}</h1>
  <p data-reveal>{{ 'general.404_text' | t }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-magnetic data-reveal>{{ 'cart.continue' | t }}{% render 'icon', name: 'arrow' %}</a>
</section>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
