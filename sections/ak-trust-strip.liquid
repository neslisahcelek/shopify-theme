<section class="ak-trust color-{{ section.settings.color_scheme }} gradient">
  <div class="ak-container">
    <div class="ak-trust__grid">
      {%- for block in section.blocks -%}
        <div class="ak-trust__item" {{ block.shopify_attributes }}>
          <div class="ak-trust__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'wash' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 6h18l-1.5 13a2 2 0 0 1-2 1.8H6.5a2 2 0 0 1-2-1.8L3 6z" />
                  <path d="M4 10c2 1.5 4 1.5 6 0s4-1.5 6 0 3.5 1.2 4 0" />
                </svg>
              {%- when 'cotton' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3a4 4 0 0 0-3.8 5.2A4 4 0 0 0 6 15a4 4 0 0 0 6 3 4 4 0 0 0 6-3 4 4 0 0 0-2.2-6.8A4 4 0 0 0 12 3z" />
                  <path d="M12 18v3" />
                </svg>
              {%- when 'shipping' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="4" width="15" height="13" rx="2" />
                  <path d="M16 8h4l3 3v6h-7V8z" />
                  <circle cx="5.5" cy="18.5" r="2.5" />
                  <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
              {%- else -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21s-7-4.5-9-9.2C1.2 7.5 4.4 4 8.2 4c2 0 3.3 1 3.8 2 .5-1 1.8-2 3.8-2 3.8 0 7 3.5 5.2 7.8C19 16.5 12 21 12 21z" />
                </svg>
            {%- endcase -%}
          </div>
          <div>
            <h2 class="ak-trust__title">{{ block.settings.title | escape }}</h2>
            <p class="ak-trust__text">{{ block.settings.text | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AK · Güven Şeridi",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Renk şeması",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Özellik",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "İkon",
          "default": "support",
          "options": [
            { "value": "support", "label": "Konfor / Destek" },
            { "value": "wash", "label": "Yıkama" },
            { "value": "cotton", "label": "Pamuklu Doku" },
            { "value": "shipping", "label": "Hızlı Kargo" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Ergonomik Sırt & Kolçak"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Açıklama",
          "default": "Hamilelikte bel boşluğunu doldurur, kolları rahatlatır."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AK · Güven Şeridi",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "support",
            "title": "Kolçaklı Ergonomik Tasarım",
            "text": "Dik oturuşta bel ve sırtı sarar, kolların yorulmasını önler."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "wash",
            "title": "30°C Yıkanabilir Kılıf",
            "text": "Gizli fermuarı sayesinde kılıfı kolayca çıkarıp yıkayabilirsiniz."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "cotton",
            "title": "%65 Pamuklu & Boncuk Elyaf",
            "text": "Terletmeyen doğal doku ve uzun süre çökme yapmayan 650+ gr dolgu."
          }
        }
      ]
    }
  ]
}
{% endschema %}
