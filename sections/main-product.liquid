{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}
<section class="product page-width" data-product data-section="{{ section.id }}" data-url="{{ product.url }}">
  <div class="product__gallery" data-gallery>
    <div class="product__media-list" data-drag-scroll>
      {%- for media in product.media -%}
        <div class="product__media ratio--{{ settings.card_ratio }}{% if media.id == featured_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}" data-reveal style="--i: {{ forloop.index0 | at_most: 2 }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.first
                  assign loading = 'eager'
                endif
              -%}
              {{ media | image_url: width: 1800 | image_tag:
                widths: '500, 750, 1000, 1300, 1600, 1800',
                sizes: '(min-width: 990px) 55vw, 100vw',
                loading: loading,
                class: 'product__img',
                alt: media.alt | default: product.title | escape
              }}
            {%- when 'video' -%}
              {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'product__img' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: class: 'product__img' }}
            {%- else -%}
              {{ media | media_tag: class: 'product__img' }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="product__media ratio--{{ settings.card_ratio }}">
          {{ 'product-apparel-1' | placeholder_svg_tag: 'product__img placeholder' }}
        </div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <button type="button" class="product__arrow product__arrow--prev" data-gallery-prev aria-label="Previous photo" disabled>{% render 'icon', name: 'arrow' %}</button>
      <button type="button" class="product__arrow product__arrow--next" data-gallery-next aria-label="Next photo">{% render 'icon', name: 'arrow' %}</button>
      <div class="product__dots" aria-hidden="true">
        {%- for media in product.media -%}<i{% if forloop.first %} class="is-active"{% endif %}></i>{%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign zoom_images = product.media | where: 'media_type', 'image' -%}
    {%- if zoom_images.size > 0 -%}
      {%- comment -%} Tapping a photo opens it full screen at full resolution. {%- endcomment -%}
      <dialog class="lightbox" data-lightbox aria-label="{{ product.title | escape }}">
        <div class="lightbox__track" data-lightbox-track>
          {%- for media in zoom_images -%}
            <figure class="lightbox__slide" data-media-id="{{ media.id }}">
              <img src="{{ media | image_url: width: 2400 }}" width="{{ media.width }}" height="{{ media.height }}" loading="lazy" alt="{{ media.alt | default: product.title | escape }}">
            </figure>
          {%- endfor -%}
        </div>
        <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
        {%- if zoom_images.size > 1 -%}
          <button type="button" class="product__arrow product__arrow--prev lightbox__arrow" data-lightbox-prev aria-label="Previous photo">{% render 'icon', name: 'arrow' %}</button>
          <button type="button" class="product__arrow product__arrow--next lightbox__arrow" data-lightbox-next aria-label="Next photo">{% render 'icon', name: 'arrow' %}</button>
        {%- endif -%}
      </dialog>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__sticky">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <span class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</span>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }} data-split>{{ product.title }}</h1>

          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }} data-price-wrap>
              {% render 'price', variant: current_variant %}
              {%- if cart.taxes_included -%}
                <small class="product__tax">{{ 'products.product.tax_included' | t }}</small>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" {{ block.shopify_attributes }} data-variant-picker>
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign is_color = false
                    assign option_name = option.name | downcase
                    if option_name == 'color' or option_name == 'renk' or option_name == 'colour'
                      assign is_color = true
                    endif
                  -%}
                  <fieldset class="variant-picker__option">
                    <legend>{{ option.name }}: <span data-option-value>{{ option.selected_value }}</span></legend>
                    <div class="variant-picker__values{% if is_color %} variant-picker__values--swatch{% endif %}">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                        <input type="radio" id="{{ input_id }}" name="option{{ option.position }}" value="{{ value | escape }}" class="visually-hidden"{% if option.selected_value == value %} checked{% endif %}>
                        <label for="{{ input_id }}" class="{% if is_color %}swatch{% else %}chip{% endif %}"{% if is_color %} style="--swatch: {% if value.swatch.color %}{{ value.swatch.color }}{% else %}{{ value | handle }}{% endif %}" title="{{ value | escape }}"{% endif %}>
                          {%- if is_color -%}<span class="visually-hidden">{{ value }}</span>{%- else -%}{{ value }}{%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <div class="product-form__row">
                  {%- if block.settings.show_quantity -%}
                    <div class="qty qty--large">
                      <button type="button" class="qty__btn" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                      <input class="qty__input" type="number" name="quantity" min="1" value="1" aria-label="{{ 'cart.quantity' | t }}">
                      <button type="button" class="qty__btn" data-qty-step="1" aria-label="{{ 'cart.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                    </div>
                  {%- endif -%}
                  <button type="submit" class="btn btn--primary btn--block product-form__submit" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
                    <span data-add-label>
                      {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                    </span>
                    {% render 'icon', name: 'arrow' %}
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product-form__dynamic">{{ form | payment_button }}</div>
                {%- endif -%}
                <p class="form-error" data-form-error hidden></p>
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}<span class="accordion__icon" aria-hidden="true"></span></summary>
              <div class="accordion__body rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>

          {%- when 'perks' -%}
            <ul class="perks" {{ block.shopify_attributes }}>
              {%- if block.settings.perk_1 != blank -%}<li>{% render 'icon', name: 'truck' %}{{ block.settings.perk_1 }}</li>{%- endif -%}
              {%- if block.settings.perk_2 != blank -%}<li>{% render 'icon', name: 'return' %}{{ block.settings.perk_2 }}</li>{%- endif -%}
            </ul>

          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "discount": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}{% else %}0{% endif %},
          "media": {{ variant.featured_media.id | default: 'null' }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

<div class="sticky-atc" data-sticky-atc aria-hidden="true">
  <div class="sticky-atc__inner">
    {%- if product.featured_media -%}
      {{ product.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
    {%- endif -%}
    <span class="sticky-atc__title">{{ product.title }}</span>
    <button type="button" class="btn btn--primary btn--small" data-sticky-atc-button tabindex="-1">{{ 'products.product.add_to_cart' | t }}</button>
  </div>
</div>

{%- liquid
  assign seo_media = current_variant.featured_media | default: product.featured_media
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if seo_media -%}"image": [{{ seo_media | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | default: product.title | json }},
    {%- if current_variant.sku != blank -%}"sku": {{ current_variant.sku | json }},{%- endif -%}
    "brand": { "@type": "Brand", "name": {{ settings.seo_brand | default: shop.name | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Ürün bilgisi",
  "class": "section-main-product",
  "settings": [],
  "blocks": [
    { "type": "vendor", "name": "Marka", "limit": 1 },
    { "type": "title", "name": "Başlık", "limit": 1 },
    { "type": "price", "name": "Fiyat", "limit": 1 },
    { "type": "variant_picker", "name": "Varyant seçici", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Satın alma düğmeleri", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Adet seçici", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Hızlı ödeme düğmeleri", "default": true }
      ]
    },
    { "type": "description", "name": "Açıklama", "limit": 1 },
    {
      "type": "perks", "name": "Avantajlar", "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Satır 1", "default": "Free shipping on orders over $100 / €100" },
        { "type": "text", "id": "perk_2", "label": "Satır 2", "default": "Free 30-day returns" }
      ]
    },
    {
      "type": "collapsible", "name": "Açılır bölüm",
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Kumaş ve bakım" },
        { "type": "richtext", "id": "content", "label": "İçerik" },
        { "type": "page", "id": "page", "label": "Sayfadan içerik" }
      ]
    },
    {
      "type": "text", "name": "Metin",
      "settings": [ { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Metin</p>" } ]
    }
  ]
}
{% endschema %}
