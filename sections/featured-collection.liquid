{%- liquid
  assign s = section.settings
  assign collection = s.collection | default: collections.all
-%}
<section class="section featured-collection{% if s.hide_head_mobile %} featured-collection--bare-mobile{% endif %}" style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}">
  <div class="page-width">
    <div class="section__head section__head--row">
      <div>
        {%- if s.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h-section" data-split>{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="btn btn--ghost" data-magnetic data-reveal>{{ 'sections.featured_collection.view_all' | t }}{% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="product-grid{% if s.layout == 'slider' %} product-grid--slider{% endif %}"{% if s.layout == 'slider' %} data-drag-scroll{% endif %}>
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.limit) -%}
          {% render 'product-card', product: blank, index: forloop.index0 %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Öne çıkan koleksiyon",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst yazı", "default": "Yeni gelenler" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Bu hafta <em>öne çıkanlar</em>" },
    { "type": "collection", "id": "collection", "label": "Koleksiyon" },
    { "type": "range", "id": "limit", "label": "Ürün sayısı", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Masaüstü sütun", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Mobil sütun", "default": "2", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    {
      "type": "select", "id": "layout", "label": "Yerleşim", "default": "grid",
      "options": [ { "value": "grid", "label": "Izgara" }, { "value": "slider", "label": "Sürüklenebilir şerit" } ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Tümünü gör düğmesi", "default": true },
    { "type": "checkbox", "id": "hide_head_mobile", "label": "Başlığı mobilde gizle", "default": false, "info": "Telefonda başlık ve Tümünü gör düğmesi gizlenir, ürünler hemen başlar." }
  ],
  "presets": [ { "name": "Öne çıkan koleksiyon" } ]
}
{% endschema %}
