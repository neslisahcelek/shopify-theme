{%- comment -%}
  Photo wardrobe: a real photo of garments hanging side-on. Each block is an
  invisible hotspot over one garment (left / width in % of the photo). On hover
  or tap that garment blurs into a silhouette, and its front-view image slides
  out of the rail, turns to face the viewer and comes forward with a product card.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="wardrobe" id="Wardrobe-{{ section.id }}">
  <div class="wardrobe__view" data-view>
    <div class="wardrobe__scroll" data-scroll>
      <div class="wardrobe__photo">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 2400 | image_tag:
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '(max-width: 749px) 220vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'wardrobe__bg',
            alt: s.image.alt | escape
          }}
        {%- else -%}
          <img class="wardrobe__bg" src="{{ s.image_asset | default: 'wardrobe-bg.jpg' | asset_url }}" width="2400" height="1600" alt="" fetchpriority="high">
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign title = b.title
            if b.product != blank
              assign title = b.product.title
            endif
          -%}
          <button type="button" class="wardrobe__spot" style="left: {{ b.left }}%; width: {{ b.width }}%" data-spot="{{ forloop.index0 }}" aria-controls="WardrobePiece-{{ block.id }}" aria-expanded="false" aria-label="{{ title | escape }}" {{ block.shopify_attributes }}>
            {%- if s.show_hints -%}<span class="wardrobe__hint" style="--i: {{ forloop.index0 }}"></span>{%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="wardrobe__dim" aria-hidden="true"></div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign product = b.product
        assign title = b.title
        assign price = b.price
        if product != blank
          assign title = product.title
          assign price = product.price | money
        endif
        assign front = b.image | default: product.featured_image
      -%}
      <div class="wardrobe__piece" id="WardrobePiece-{{ block.id }}" data-piece="{{ forloop.index0 }}" role="group" aria-label="{{ title | escape }}">
        <div class="wardrobe__front">
          {%- if front != blank -%}
            {{ front | image_url: width: 1000 | image_tag: loading: 'eager', alt: title | escape }}
          {%- elsif b.image_asset != blank -%}
            <img src="{{ b.image_asset | asset_url }}" alt="{{ title | escape }}">
          {%- endif -%}
        </div>
        <div class="wardrobe__card">
          {%- if b.tag != blank -%}<span class="wardrobe__tag">{{ b.tag }}</span>{%- endif -%}
          <p class="wardrobe__title">{{ title }}</p>
          {%- if price != blank -%}<p class="wardrobe__price">{{ price }}</p>{%- endif -%}
          {%- if product != blank -%}
            {%- if product.available and product.has_only_default_variant -%}
              <form action="{{ routes.cart_add_url }}" method="post" class="wardrobe__form" data-product-form>
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn btn--primary wardrobe__btn">{{ 'products.product.add_to_cart' | t }}</button>
              </form>
            {%- elsif product.available -%}
              <a href="{{ product.url }}" class="btn btn--primary wardrobe__btn">{{ 'products.card.choose_options' | t }}</a>
            {%- else -%}
              <span class="btn wardrobe__btn wardrobe__btn--off">{{ 'products.product.sold_out' | t }}</span>
            {%- endif -%}
          {%- else -%}
            <a href="{{ b.link | default: routes.all_products_collection_url }}" class="btn btn--primary wardrobe__btn">{{ 'products.product.add_to_cart' | t }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .wardrobe { --e: cubic-bezier(.16, 1, .3, 1); padding-top: var(--header-h, 76px); }
  .wardrobe__view {
    --h: min(66.67vw, calc(100svh - var(--header-h, 76px) - 24px));
    position: relative; height: var(--h); overflow: hidden; isolation: isolate;
    container-type: size; background: #e9e4dc;
  }
  .wardrobe__scroll { position: absolute; inset: 0; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
  .wardrobe__scroll::-webkit-scrollbar { display: none; }
  .wardrobe__photo { position: relative; width: max(100%, calc(var(--h) * 1.5)); aspect-ratio: 3 / 2; }
  .wardrobe__bg { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* hotspot: the garment in the photo turns into a soft silhouette when chosen */
  .wardrobe__spot {
    position: absolute; top: 0; bottom: 0; padding: 0; border: 0; background: transparent; cursor: pointer;
    transition: backdrop-filter .6s var(--e), -webkit-backdrop-filter .6s var(--e), background-color .6s var(--e);
    -webkit-tap-highlight-color: transparent;
  }
  .wardrobe__spot:focus-visible { outline: 2px solid #fff; outline-offset: -6px; }
  .wardrobe__spot.is-active { -webkit-backdrop-filter: blur(7px) grayscale(.6); backdrop-filter: blur(7px) grayscale(.6); background-color: rgba(255, 255, 255, .12); z-index: 2; }

  .wardrobe__hint { position: absolute; top: 38%; left: 50%; width: 14px; height: 14px; margin: -7px; border-radius: 50%; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.25); transition: opacity .4s; }
  .wardrobe__hint::after { content: ""; position: absolute; inset: -8px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.9); animation: wardrobe-ping 2.4s var(--e) infinite; animation-delay: calc(var(--i) * .35s); }
  .wardrobe__view.is-active .wardrobe__hint { opacity: 0; }

  .wardrobe__dim { position: absolute; inset: 0; z-index: 3; pointer-events: none; background: rgba(28, 18, 8, .38); opacity: 0; transition: opacity .6s var(--e); }
  .wardrobe__view.is-active .wardrobe__dim { opacity: 1; }

  /* the garment that comes out of the wardrobe */
  .wardrobe__piece { position: absolute; z-index: 4; top: 5cqh; height: 88cqh; left: var(--px, 0px); pointer-events: none; }
  .wardrobe__front { height: 100%; perspective: 1400px; }
  .wardrobe__front img {
    display: block; height: 100%; width: auto; transform-origin: 50% 8%;
    opacity: 0;
    transform: translate3d(var(--fromx, 0px), 0, -380px) rotateY(var(--roty, 80deg)) scale(.8);
    filter: brightness(.7) drop-shadow(0 20px 26px rgba(20, 10, 0, .2));
    transition: transform 1s var(--e), opacity .35s ease, filter 1s var(--e);
  }
  .wardrobe__piece.is-active { pointer-events: auto; }
  .wardrobe__piece.is-active .wardrobe__front img {
    opacity: 1; transform: none;
    filter: brightness(1) drop-shadow(0 46px 50px rgba(20, 10, 0, .4));
  }

  /* product card */
  .wardrobe__card {
    position: absolute; top: 34%; left: calc(100% + 18px); width: 230px; padding: 16px 18px 18px;
    border-radius: 14px; background: #fff; color: #121212; text-align: left;
    box-shadow: 0 24px 50px -12px rgba(20, 10, 0, .4), 0 2px 6px rgba(0,0,0,.08);
    opacity: 0; visibility: hidden; transform: translate3d(-14px, 8px, 0) scale(.96); transform-origin: 0 50%;
    transition: opacity .35s var(--e), transform .6s var(--e), visibility 0s linear .6s;
  }
  .wardrobe__piece[data-side="left"] .wardrobe__card { left: auto; right: calc(100% + 18px); transform: translate3d(14px, 8px, 0) scale(.96); transform-origin: 100% 50%; }
  .wardrobe__piece.is-active .wardrobe__card { opacity: 1; visibility: visible; transform: none; transition-delay: .3s, .3s, 0s; }
  .wardrobe__tag { display: inline-block; margin-bottom: 8px; padding: 3px 8px; border-radius: 99px; background: #f1ede6; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .wardrobe__title { margin: 0; font-family: var(--display); font-weight: 700; font-size: 17px; line-height: 1.2; letter-spacing: -0.01em; }
  .wardrobe__price { margin: 4px 0 0; font-size: 14px; color: rgba(18,18,18,.62); }
  .wardrobe__form { margin: 0; }
  .wardrobe__btn { width: 100%; min-height: 42px; margin-top: 14px; padding: 0 16px; font-size: 13px; }
  .wardrobe__btn--off { opacity: .5; pointer-events: none; }

  @keyframes wardrobe-ping { 0% { transform: scale(.6); opacity: 1; } 80%, 100% { transform: scale(1.6); opacity: 0; } }

  @media (max-width: 749px) {
    .wardrobe__view { --h: 72svh; }
    .wardrobe__piece { top: 4cqh; height: 58cqh; }
    .wardrobe__card, .wardrobe__piece[data-side="left"] .wardrobe__card {
      top: calc(100% + 3cqh); left: 50%; right: auto; width: min(240px, 80vw);
      transform: translate3d(-50%, 10px, 0) scale(.96); transform-origin: 50% 0;
    }
    .wardrobe__piece.is-active .wardrobe__card { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wardrobe__hint::after { animation: none; }
    .wardrobe__front img, .wardrobe__card, .wardrobe__spot, .wardrobe__dim { transition-duration: .01s; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('Wardrobe-{{ section.id }}');
    if (!root) return;
    const view = root.querySelector('[data-view]');
    const scroller = root.querySelector('[data-scroll]');
    const spots = [...root.querySelectorAll('[data-spot]')];
    const pieces = [...root.querySelectorAll('[data-piece]')];
    const canHover = window.matchMedia('(hover: hover)').matches;
    const mobile = () => window.matchMedia('(max-width: 749px)').matches;
    let current = -1;

    // start with the middle of the rail in view when the photo is wider than the screen
    const centre = () => { scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) / 2; };
    centre();
    // phones fire resize when the address bar hides; only react to real width changes
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      close();
      centre();
    });

    // place the front view: next to its garment, kept on screen, card on the roomier side
    const place = (i) => {
      const piece = pieces[i];
      const img = piece.querySelector('img');
      const v = view.getBoundingClientRect();
      const r = spots[i].getBoundingClientRect();
      const spotX = r.left + r.width / 2 - v.left;
      const fw = img ? img.offsetWidth : 0;
      const card = mobile() ? 0 : 250;
      const pad = 16;
      let left;
      let side = 'right';
      if (mobile()) {
        left = (v.width - fw) / 2;
      } else {
        side = spotX > v.width * 0.55 ? 'left' : 'right';
        left = spotX - fw / 2;
        const min = pad + (side === 'left' ? card : 0);
        const max = v.width - fw - pad - (side === 'right' ? card : 0);
        left = Math.max(min, Math.min(max, left));
      }
      piece.dataset.side = side;
      piece.style.setProperty('--px', `${left}px`);
      piece.style.setProperty('--fromx', `${spotX - (left + fw / 2)}px`);
      piece.style.setProperty('--roty', `${spotX < left + fw / 2 ? -80 : 80}deg`);
    };

    const open = (i) => {
      if (i === current) return;
      close();
      place(i);
      current = i;
      // let the start position apply before animating out
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (current !== i) return;
        view.classList.add('is-active');
        spots[i].classList.add('is-active');
        spots[i].setAttribute('aria-expanded', 'true');
        pieces[i].classList.add('is-active');
      }));
    };
    function close() {
      current = -1;
      view.classList.remove('is-active');
      spots.forEach((s) => { s.classList.remove('is-active'); s.setAttribute('aria-expanded', 'false'); });
      pieces.forEach((p) => p.classList.remove('is-active'));
    }

    spots.forEach((spot, i) => {
      if (canHover) spot.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') open(i); });
      spot.addEventListener('click', () => (current === i ? close() : open(i)));
      spot.addEventListener('focus', () => open(i));
    });
    if (canHover) view.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') close(); });
    scroller.addEventListener('scroll', () => { if (current !== -1 && mobile()) close(); }, { passive: true });
    document.addEventListener('click', (e) => { if (!view.contains(e.target)) close(); });
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    document.addEventListener('shopify:block:select', (e) => {
      const i = spots.findIndex((s) => s.dataset.shopifyEditorBlock && s.dataset.shopifyEditorBlock.includes(e.detail.blockId));
      if (i > -1) open(i);
    });
    document.addEventListener('shopify:block:deselect', close);
  })();
</script>

{% schema %}
{
  "name": "Fotoğraflı gardırop",
  "tag": "section",
  "class": "section-wardrobe",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Gardırop fotoğrafı", "info": "Kıyafetlerin askıda yandan göründüğü yatay (3:2) bir fotoğraf. Değiştirirseniz her kıyafetin konumunu yeniden ayarlayın." },
    { "type": "text", "id": "image_asset", "label": "Fotoğraf (tema dosyası)", "default": "wardrobe-bg.jpg", "info": "Yukarıdaki boşsa kullanılır." },
    { "type": "checkbox", "id": "show_hints", "label": "Kıyafetlerin üstünde nokta göster", "default": true }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Kıyafet",
      "limit": 12,
      "settings": [
        { "type": "product", "id": "product", "label": "Ürün", "info": "Seçerseniz ad, fiyat, Sepete Ekle ve ön görsel bu üründen gelir." },
        { "type": "image_picker", "id": "image", "label": "Ön görsel", "info": "Kıyafetin önden, arka planı silinmiş PNG'si." },
        { "type": "text", "id": "image_asset", "label": "Ön görsel (tema dosyası)", "info": "Yukarıdakiler boşsa kullanılır." },
        { "type": "range", "id": "left", "label": "Fotoğraftaki konum (soldan %)", "min": 0, "max": 95, "step": 1, "default": 40 },
        { "type": "range", "id": "width", "label": "Genişlik (%)", "min": 3, "max": 40, "step": 1, "default": 15 },
        { "type": "text", "id": "title", "label": "Ad (ürün seçilmediyse)", "default": "Essential White Tee" },
        { "type": "text", "id": "price", "label": "Fiyat (ürün seçilmediyse)", "default": "$29.00" },
        { "type": "url", "id": "link", "label": "Bağlantı (ürün seçilmediyse)" },
        { "type": "text", "id": "tag", "label": "Etiket", "info": "örn. New, Bestseller" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fotoğraflı gardırop",
      "blocks": [
        { "type": "piece", "settings": { "image_asset": "wardrobe-blue-shirt.webp", "left": 3, "width": 14, "title": "Sky Linen Henley", "price": "$49.00" } },
        { "type": "piece", "settings": { "image_asset": "wardrobe-white-tee.webp", "left": 17, "width": 18, "title": "Essential White Tee", "price": "$29.00" } },
        { "type": "piece", "settings": { "image_asset": "wardrobe-henley.webp", "left": 35, "width": 17, "title": "White Linen Henley", "price": "$49.00", "tag": "New" } },
        { "type": "piece", "settings": { "image_asset": "wardrobe-cream-tee.webp", "left": 52, "width": 15, "title": "Cream Everyday Tee", "price": "$29.00" } },
        { "type": "piece", "settings": { "image_asset": "wardrobe-beige-tee.webp", "left": 67, "width": 9, "title": "Sand Relaxed Tee", "price": "$32.00" } }
      ]
    }
  ]
}
{% endschema %}
