{%- assign s = section.settings -%}
<section class="section testimonials{% if s.dark %} scheme-dark{% endif %}" style="--marquee-duration: {{ s.speed }}s">
  <div class="page-width">
    <div class="section__head">
      {%- if s.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h-section" data-split>{{ s.heading }}</h2>{%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="marquee marquee--cards">
      <div class="marquee__track">
        {%- for i in (1..2) -%}
          <div class="marquee__group"{% if forloop.last %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <blockquote class="quote-card" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>
                <div class="quote-card__stars" aria-label="{{ block.settings.rating }}/5">
                  {%- for star in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
                </div>
                <div class="quote-card__text rte">{{ block.settings.quote }}</div>
                <footer>
                  <b>{{ block.settings.author }}</b>
                  {%- if block.settings.product != blank -%}<small>{{ block.settings.product.title }}</small>{%- endif -%}
                </footer>
              </blockquote>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Müşteri yorumları",
  "class": "section-testimonials",
  "settings": [
    { "type": "paragraph", "content": "Buraya yalnızca gerçek müşteri yorumlarını ekleyin." },
    { "type": "text", "id": "eyebrow", "label": "Üst yazı", "default": "Yorumlar" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Müşterilerimiz <em>ne diyor?</em>" },
    { "type": "range", "id": "speed", "label": "Kayma süresi", "min": 20, "max": 120, "step": 5, "unit": "sn", "default": 60 },
    { "type": "checkbox", "id": "dark", "label": "Koyu arka plan", "default": false }
  ],
  "blocks": [
    {
      "type": "quote", "name": "Yorum",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Yorum", "default": "<p>Müşteri yorumunu buraya yazın.</p>" },
        { "type": "text", "id": "author", "label": "İsim", "default": "Müşteri adı" },
        { "type": "range", "id": "rating", "label": "Puan", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "product", "id": "product", "label": "İlgili ürün" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Müşteri yorumları",
      "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ]
    }
  ]
}
{% endschema %}
