<section class="section blog page-width">
  <h1 class="h-display" data-split>{{ blog.title }}</h1>
  {%- paginate blog.articles by 9 -%}
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card" data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}" data-cursor="{{ 'blog.read' | t }}">
          <div class="article-card__media img-reveal ratio--landscape">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | escape }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <small>{{ article.published_at | time_tag: format: 'date' }}</small>
          <h2>{{ article.title }}</h2>
          {%- if article.excerpt != blank -%}<p>{{ article.excerpt | strip_html | truncate: 140 }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
