<section id="ak-compare" class="ak-section color-{{ section.settings.color_scheme }} gradient">
  <div class="ak-container">
    <div class="ak-section-head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="ak-eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      <h2 class="ak-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="ak-lead" style="margin-bottom:0;">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </div>

    <div class="ak-compare__grid">
      <div class="ak-anatomy-box">
        {%- if section.settings.anatomy_image != blank -%}
          {%- assign anatomy_alt = section.settings.anatomy_image.alt | default: 'Ürün ölçü ve malzeme anatomisi' | escape -%}
          <div style="border-radius:16px;overflow:hidden;margin-bottom:1.6rem;">
            {{
              section.settings.anatomy_image
              | image_url: width: 900
              | image_tag:
                widths: '450, 700, 900',
                sizes: '(min-width: 990px) 42vw, 90vw',
                alt: anatomy_alt,
                loading: 'lazy'
            }}
          </div>
        {%- else -%}
          <svg
            viewBox="0 0 520 340"
            width="520"
            height="340"
            role="img"
            aria-label="54x42 cm Kolçaklı Yastık Ölçü Diyagramı"
            style="width:100%;height:auto;display:block;border-radius:16px;background:#EAE3DA;"
          >
            <!-- Dimension guides -->
            <line x1="95" y1="295" x2="425" y2="295" stroke="#2E2A27" stroke-width="1.5" stroke-dasharray="4 4" />
            <text x="260" y="318" text-anchor="middle" fill="#2E2A27" font-family="sans-serif" font-size="14" font-weight="700">
              Genişlik: 54 cm (Kolçaklar Dahil)
            </text>
            <line x1="65" y1="62" x2="65" y2="262" stroke="#2E2A27" stroke-width="1.5" stroke-dasharray="4 4" />
            <text x="52" y="166" text-anchor="middle" fill="#2E2A27" font-family="sans-serif" font-size="14" font-weight="700" transform="rotate(-90 52 166)">
              Yükseklik: 42 cm
            </text>

            <!-- Pillow outline -->
            <path d="M150 250 C150 110, 190 65, 260 65 C330 65, 370 110, 370 250 Z" fill="#3B3E42" />
            <rect x="102" y="178" width="60" height="78" rx="26" fill="#4B4E53" />
            <rect x="358" y="178" width="60" height="78" rx="26" fill="#4B4E53" />
            <rect x="165" y="200" width="190" height="58" rx="24" fill="#45484D" />

            <!-- Callout pins -->
            <circle cx="260" cy="115" r="7" fill="#C47D63" stroke="#F7F4F0" stroke-width="2.5" />
            <text x="385" y="96" fill="#2E2A27" font-family="sans-serif" font-size="12" font-weight="600">Yüksek Sırt Desteği</text>
            <line x1="267" y1="113" x2="380" y2="96" stroke="#C47D63" stroke-width="1.5" />

            <circle cx="132" cy="205" r="7" fill="#C47D63" stroke="#F7F4F0" stroke-width="2.5" />
            <text x="108" y="138" fill="#2E2A27" font-family="sans-serif" font-size="12" font-weight="600">Sabit Kolçak</text>
            <line x1="132" y1="198" x2="132" y2="145" stroke="#C47D63" stroke-width="1.5" />

            <circle cx="368" cy="225" r="7" fill="#C47D63" stroke="#F7F4F0" stroke-width="2.5" />
            <text x="392" y="155" fill="#2E2A27" font-family="sans-serif" font-size="12" font-weight="600">Gizli Fermuar</text>
            <line x1="373" y1="220" x2="415" y2="162" stroke="#C47D63" stroke-width="1.5" />
          </svg>
        {%- endif -%}

        <div class="ak-specs-list">
          <div class="ak-spec-pill">
            <span>Ölçüler</span>
            <strong>54 × 42 cm</strong>
          </div>
          <div class="ak-spec-pill">
            <span>Dolgu Ağırlığı</span>
            <strong>650+ gr Boncuk Elyaf</strong>
          </div>
          <div class="ak-spec-pill">
            <span>Dış Kumaş</span>
            <strong>%65 Pamuk / %35 Pes</strong>
          </div>
          <div class="ak-spec-pill">
            <span>Bakım</span>
            <strong>30°C Yıkanabilir Kılıf</strong>
          </div>
        </div>
      </div>

      <div>
        <table class="ak-compare-table">
          <thead>
            <tr>
              <th>Özellik</th>
              <th class="is-brand">{{ section.settings.brand_col_title | escape }}</th>
              <th>{{ section.settings.other_col_title | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <td><strong>{{ block.settings.feature | escape }}</strong></td>
                <td class="is-brand">
                  <span class="ak-check-yes">✓</span> {{ block.settings.brand_value | escape }}
                </td>
                <td>
                  <span class="ak-check-no">✕</span> {{ block.settings.other_value | escape }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AK · Anatomi & Kıyas",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Renk şeması",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Üst rozet",
      "default": "Ölçü & Kalite Farkı"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Başlık",
      "default": "Neden Sıradan Yastıklar Yerine <em>Anne Keyfi?</em>"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Alt açıklama",
      "default": "İki yastığı üst üste koyduğunuzda kayar ve belinizi boşta bırakır. Anne Keyfi kolçaklı yastığı ise gövdenizi tek parça halinde sarar."
    },
    {
      "type": "image_picker",
      "id": "anatomy_image",
      "label": "Özel ölçü / detay görseli (boş bırakılırsa diyagram gösterilir)"
    },
    {
      "type": "text",
      "id": "brand_col_title",
      "label": "Marka sütunu başlığı",
      "default": "Anne Keyfi Yastığı"
    },
    {
      "type": "text",
      "id": "other_col_title",
      "label": "Diğer sütun başlığı",
      "default": "Standart Yastıklar"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Karşılaştırma satırı",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Özellik",
          "default": "Yan Kolçak Desteği"
        },
        {
          "type": "text",
          "id": "brand_value",
          "label": "Anne Keyfi değeri",
          "default": "Sabit ve dolgun kolçaklar"
        },
        {
          "type": "text",
          "id": "other_value",
          "label": "Standart yastık değeri",
          "default": "Yok, kollar desteksiz kalır"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AK · Anatomi & Kıyas",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Yan Kolçak Desteği",
            "brand_value": "Kolları ve omuzları saran yan kanatlar",
            "other_value": "Yok"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Otururken Bel Formu",
            "brand_value": "Kaymayan dik & ergonomik bel eğimi",
            "other_value": "Çabuk ezilir ve kayar"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "İç Dolgu Malzemesi",
            "brand_value": "650+ gr yüksek hacimli boncuk elyaf",
            "other_value": "Kısa sürede topaklanan düz elyaf"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Temizlik & Hijyen",
            "brand_value": "Gizli fermuarlı, 30°C yıkanabilir kılıf",
            "other_value": "Kılıf çıkmaz, makineye sığmaz"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Kumaş Dokusu",
            "brand_value": "%65 Pamuklu, solmaya dayanıklı nefes alan doku",
            "other_value": "Terleten sentetik yüzeyler"
          }
        }
      ]
    }
  ]
}
{% endschema %}
