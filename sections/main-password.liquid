<section class="password scheme-dark">
  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="password__inner">
    <span class="eyebrow">{{ shop.name }}</span>
    <h1 class="h-display" data-split>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="newsletter-form__success">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__field">
          <label for="PasswordEmail" class="visually-hidden">{{ 'sections.newsletter.email' | t }}</label>
          <input id="PasswordEmail" type="email" name="contact[email]" required placeholder="{{ 'sections.newsletter.email' | t }}">
          <button type="submit" class="btn btn--light">{{ 'sections.newsletter.subscribe' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link-underline">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="newsletter-form__field">
          <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="btn btn--light">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Şifre sayfası",
  "settings": [ { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Çok <em>yakında</em>." } ]
}
{% endschema %}
