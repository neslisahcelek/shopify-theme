{%- assign s = section.settings -%}
<section class="section rich-text rich-text--{{ s.align }}{% if s.dark %} scheme-dark{% endif %}">
  <div class="page-width rich-text__inner">
    {%- if s.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="{% if s.size == 'huge' %}h-display{% else %}h-section{% endif %}{% if s.scrub %} text-scrub{% endif %}" {% if s.scrub %}data-scrub{% else %}data-split{% endif %}>{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}<div class="rte" data-reveal style="--i: 2">{{ s.text }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <a href="{{ s.button_link | default: '#' }}" class="btn btn--ghost" data-magnetic data-reveal style="--i: 3">{{ s.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Metin",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst yazı" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Moda geçer, <em>stil</em> kalır." },
    {
      "type": "select", "id": "size", "label": "Başlık boyutu", "default": "huge",
      "options": [ { "value": "large", "label": "Büyük" }, { "value": "huge", "label": "Dev" } ]
    },
    { "type": "checkbox", "id": "scrub", "label": "Kaydırdıkça kelime kelime aydınlansın", "default": true },
    { "type": "richtext", "id": "text", "label": "Metin" },
    { "type": "text", "id": "button_label", "label": "Düğme" },
    { "type": "url", "id": "button_link", "label": "Düğme bağlantısı" },
    {
      "type": "select", "id": "align", "label": "Hizalama", "default": "center",
      "options": [ { "value": "left", "label": "Sol" }, { "value": "center", "label": "Orta" } ]
    },
    { "type": "checkbox", "id": "dark", "label": "Koyu arka plan", "default": false }
  ],
  "presets": [ { "name": "Metin" } ]
}
{% endschema %}
