<section class="section cart-page page-width">
  <h1 class="h-display" data-split>{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid" id="CartPageForm">
      <ul class="cart-page__items">
        {%- for item in cart.items -%}
          <li class="line-item line-item--page" data-reveal style="--i: {{ forloop.index0 | at_most: 4 }}">
            <a href="{{ item.url }}" class="line-item__media">
              {%- if item.image -%}{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.title | escape }}{%- endif -%}
            </a>
            <div class="line-item__info">
              <a href="{{ item.url }}" class="line-item__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<span class="line-item__variant">{{ item.variant.title }}</span>{%- endunless -%}
              {%- for property in item.properties -%}
                {%- unless property.last == blank or property.first contains '_' -%}
                  <span class="line-item__variant">{{ property.first }}: {{ property.last }}</span>
                {%- endunless -%}
              {%- endfor -%}
              <div class="line-item__row">
                <label class="qty">
                  <span class="visually-hidden">{{ 'cart.quantity' | t }}</span>
                  <input class="qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-auto-submit>
                </label>
                <span class="line-item__price">{{ item.final_line_price | money }}</span>
              </div>
              <a href="{{ item.url_to_remove }}" class="line-item__remove link-underline">{{ 'cart.remove' | t }}</a>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="cart-page__summary" data-reveal>
        <div class="drawer__total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        {%- if section.settings.show_note -%}
          <label class="cart-page__note">
            <span>{{ 'cart.note' | t }}</span>
            <textarea name="note" rows="3">{{ cart.note }}</textarea>
          </label>
        {%- endif -%}
        <p class="drawer__note">{{ 'cart.taxes_note' | t }}</p>
        <button type="submit" name="checkout" class="btn btn--primary btn--block">{{ 'cart.checkout' | t }}{% render 'icon', name: 'arrow' %}</button>
        <noscript><button type="submit" class="btn btn--ghost btn--block">{{ 'cart.update' | t }}</button></noscript>
      </aside>
    </form>
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-magnetic>{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sepet",
  "settings": [ { "type": "checkbox", "id": "show_note", "label": "Sipariş notu", "default": true } ]
}
{% endschema %}
