{%- assign s = section.settings -%}
{%- liquid
  assign swap = false
  if s.image != blank
    if s.image_hover != blank or s.image_hover_asset != blank
      assign swap = true
    endif
  endif
  assign has_image = false
  if s.image != blank or s.image_hover != blank or s.image_hover_asset != blank
    assign has_image = true
  endif
-%}
<section class="section image-text image-text--{{ s.image_position }}{% if s.dark %} scheme-dark{% endif %}{% if s.cutout %} image-text--cutout{% endif %}{% if swap %} image-text--swap{% endif %}{% unless has_image %} image-text--noimg{% endunless %}">
  <div class="page-width image-text__grid">
    {%- if has_image -%}
    <div class="image-text__media img-reveal" data-reveal{% if swap %} data-swap{% endif %}>
      <div class="image-text__inner"{% unless s.cutout %} data-parallax="{{ s.parallax | divided_by: 100.0 }}"{% endunless %}>
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1600 | image_tag:
            widths: '500, 800, 1100, 1400, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            alt: s.image.alt | escape
          }}
          {%- if swap -%}
            {%- comment -%} Second view (e.g. the back) cross-fades in on hover / tap. {%- endcomment -%}
            {%- if s.image_hover != blank -%}
              {{ s.image_hover | image_url: width: 1600 | image_tag:
                widths: '500, 800, 1100, 1400, 1600',
                sizes: '(min-width: 750px) 50vw, 100vw',
                loading: 'lazy',
                class: 'image-text__alt',
                alt: s.image_hover.alt | escape
              }}
            {%- else -%}
              <img src="{{ s.image_hover_asset | asset_url }}" class="image-text__alt" alt="" loading="lazy" width="{{ s.image.width }}" height="{{ s.image.height }}">
            {%- endif -%}
          {%- endif -%}
        {%- elsif s.image_hover_asset != blank -%}
          <img src="{{ s.image_hover_asset | asset_url }}" alt="" loading="lazy" width="682" height="1024">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      {%- if s.badge != blank -%}
        <span class="spin-badge" aria-hidden="true">
          <svg viewBox="0 0 100 100"><defs><path id="circle-{{ section.id }}" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/></defs><text><textPath href="#circle-{{ section.id }}">{{ s.badge }} • {{ s.badge }} • </textPath></text></svg>
        </span>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="image-text__content">
      {%- if s.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h-section" data-split>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte" data-reveal style="--i: 2">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: '#' }}" class="btn {% if s.dark %}btn--light{% else %}btn--primary{% endif %}" data-magnetic data-reveal style="--i: 3">
          <span>{{ s.button_label }}</span>{% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Görsel ve metin",
  "class": "section-image-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Görsel" },
    {
      "type": "select", "id": "image_position", "label": "Görsel konumu", "default": "left",
      "options": [ { "value": "left", "label": "Solda" }, { "value": "right", "label": "Sağda" } ]
    },
    { "type": "image_picker", "id": "image_hover", "label": "Üzerine gelince görsel", "info": "Örn. ürünün arkadan görünüşü. Aynı boyutta ve aynı kadrajda bir görsel kullanın; telefonda dokununca değişir." },
    { "type": "text", "id": "image_hover_asset", "label": "İkinci görsel (tema dosyası)", "info": "Yukarıdaki görsel boşsa tema klasöründeki bu dosya kullanılır, örn. story-back.png" },
    { "type": "checkbox", "id": "cutout", "label": "Arka plansız görsel", "default": false, "info": "Arka planı silinmiş PNG için: kutu kalkar, görsel kırpılmadan alt kenara oturur." },
    { "type": "range", "id": "parallax", "label": "Parallax gücü", "min": 0, "max": 30, "step": 5, "unit": "%", "default": 10 },
    { "type": "text", "id": "badge", "label": "Dönen rozet metni", "default": "El yapımı • İstanbul" },
    { "type": "text", "id": "eyebrow", "label": "Üst yazı", "default": "Hikayemiz" },
    { "type": "inline_richtext", "id": "heading", "label": "Başlık", "default": "Az ama <em>öz</em> bir gardırop." },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Her parçayı yıllarca giyilmesi için tasarlıyoruz. Doğal kumaşlar, adil üretim ve trendlerden bağımsız kesimler.</p>" },
    { "type": "text", "id": "button_label", "label": "Düğme", "default": "Hikayeyi oku" },
    { "type": "url", "id": "button_link", "label": "Düğme bağlantısı" },
    { "type": "checkbox", "id": "dark", "label": "Koyu arka plan", "default": false }
  ],
  "presets": [ { "name": "Görsel ve metin" } ]
}
{% endschema %}
