<section class="section page-width">
  <div class="section__head">
    {%- assign default_heading = 'collections.all_title' | t -%}
    <h1 class="h-display" data-split>{{ section.settings.heading | default: default_heading }}</h1>
  </div>
  <div class="collection-grid" style="--cols: 3">
    {%- for collection in collections -%}
      {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
      <a href="{{ collection.url }}" class="collection-tile" data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}" data-cursor="{{ 'products.card.view' | t }}">
        <div class="collection-tile__media img-reveal">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 1000 | image_tag:
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 750px) 33vw, 100vw',
              loading: 'lazy',
              alt: ''
            }}
          {%- else -%}
            {{ 'collection-apparel-2' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <div class="collection-tile__info">
          <h3>{{ collection.title }}</h3>
          <span class="collection-tile__arrow">{% render 'icon', name: 'arrow' %}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Tüm koleksiyonlar",
  "settings": [ { "type": "text", "id": "heading", "label": "Başlık" } ]
}
{% endschema %}
