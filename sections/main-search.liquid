<section class="section search-page page-width" style="--cols: 4; --cols-mobile: 2">
  <h1 class="h-display" data-split>{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <input type="hidden" name="type" value="product">
    <label for="SearchPageInput" class="visually-hidden">{{ 'search.title' | t }}</label>
    <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'sections.header.search_placeholder' | t }}" class="search-panel__input">
    <button type="submit" class="icon-btn" aria-label="{{ 'search.title' | t }}">{% render 'icon', name: 'arrow' %}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="eyebrow">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, index: forloop.index0 %}
            {%- else -%}
              <a href="{{ item.url }}" class="search-result" data-reveal>
                <small>{{ item.object_type }}</small>
                <h3>{{ item.title }}</h3>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="empty-state"><p>{{ 'search.no_results' | t }}</p></div>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Arama sonuçları", "settings": [] }
{% endschema %}
