{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  {% render 'css-variables' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-gift-card">
  <main class="gift-card page-width page-width--narrow">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="h-section">{{ 'gift_card.title' | t }}</h1>

    <div class="gift-card__card scheme-gradient">
      <span class="gift-card__amount">{{ gift_card.balance | money }}</span>
      {%- if gift_card.balance != gift_card.initial_value -%}
        {%- assign initial_money = gift_card.initial_value | money -%}
        <small>{{ 'gift_card.initial' | t: value: initial_money }}</small>
      {%- endif -%}
      {%- if gift_card.expired or gift_card.enabled == false -%}
        <span class="badge">{{ 'gift_card.expired' | t }}</span>
      {%- endif -%}
    </div>

    <p>{{ 'gift_card.code' | t }}</p>
    <input class="gift-card__code" type="text" value="{{ gift_card.code | format_code }}" readonly onfocus="this.select()" aria-label="{{ 'gift_card.code' | t }}">

    <div id="GiftCardQr" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>

    <div class="gift-card__actions">
      <a href="{{ shop.url }}" class="btn btn--primary">{{ 'gift_card.shop' | t }}</a>
      <button type="button" class="btn btn--ghost" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
    </div>
    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Apple Wallet" loading="lazy"></a>
    {%- endif -%}
  </main>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('GiftCardQr');
      if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
    });
  </script>
</body>
</html>
