<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js{% if settings.enable_animations %} motion{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

  {% render 'css-variables' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script>
    document.documentElement.classList.replace('no-js', 'js');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.remove('motion');
    window.theme = { routes: {}, settings: {}, strings: {} };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
</body>
</html>
