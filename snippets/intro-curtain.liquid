{%- comment -%}
  Style Vibeus — Interactive 3D WebGL Boutique Walkthrough
  -------------------------------------------------------------
  - Phase 1 (~2.4s): Doors slide open & camera walks into the store
  - Phase 2 (Interactive): User can freely walk forward/back (scroll/swipe)
    and look around left/right (drag/mouse) inside the 3D boutique
  - Always-available "Siteye Geç ✕" & "Alışverişe Başla →" exit controls
{%- endcomment -%}

<script>
  /* Instant check to prevent flash on session return */
  (function() {
    try {
      if (sessionStorage.getItem('sv_curtain_seen') === '1') {
        document.documentElement.classList.add('sv-curtain-dismissed');
      }
    } catch (e) {}
  })();
</script>

{%- capture garment_urls -%}
[
  {{ 'rack-cutout-2.png' | asset_url | json }},
  {{ 'rack-cutout-4.png' | asset_url | json }},
  {{ 'rack-cutout-1.png' | asset_url | json }},
  {{ 'rack-cutout-3.png' | asset_url | json }},
  {{ 'rack-cutout-0.png' | asset_url | json }},
  {{ 'rack-cutout-7.png' | asset_url | json }}
]
{%- endcapture -%}

<aside
  id="sv-curtain-intro"
  class="curtain-intro"
  role="dialog"
  aria-modal="true"
  aria-label="Style Vibeus 3D Sanal Mağaza"
  tabindex="-1"
  data-garments="{{ garment_urls | strip | escape }}"
>
  <canvas id="sv-3d-walkthrough-canvas" class="curtain-3d-canvas"></canvas>

  <!-- Interactive Store HUD -->
  <div class="curtain-hud">
    <!-- Top-right instant exit button -->
    <button
      type="button"
      id="sv-curtain-skip"
      class="curtain-skip"
      aria-label="3D Mağazadan Çık ve Siteye Geç"
    >
      <span class="curtain-skip__text">Siteye Geç</span>
      <span class="curtain-skip__icon" aria-hidden="true">✕</span>
    </button>

    <!-- Bottom status / interactive exploration bar -->
    <div class="curtain-hud__bottom">
      <!-- Entering progress (shown during 0-2.4s entrance) -->
      <div class="curtain-entering-pill" id="sv-curtain-entering">
        <div class="curtain-progress">
          <span class="curtain-progress__fill"></span>
        </div>
        <span class="curtain-hint__text">Mağazaya giriliyor...</span>
      </div>

      <!-- Explore bar (shown once inside the store) -->
      <div class="curtain-explore-bar" id="sv-curtain-explore" hidden>
        <span class="curtain-explore-bar__hint">
          Kaydır: İlerle &nbsp;·&nbsp; Sürükle: Etrafa Bak
        </span>
        <button type="button" id="sv-curtain-enter-shop" class="curtain-enter-btn">
          <span>Alışverişe Başla</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</aside>
