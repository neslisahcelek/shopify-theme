{%- comment -%}
  Style Vibeus — 3D WebGL Boutique Walkthrough Intro
  -------------------------------------------------------------
  - Real-time Three.js 3D architectural showroom walkthrough (~2.2s)
  - Warm travertine & cream luxury palette matching DESIGN_SYSTEM.md
  - Sliding glass doors, left/right illuminated racks with real products,
    center focal pedestal & STYLE VIBEUS brand wall
  - Session storage guard ('sv_curtain_seen'), Skip button, tap/Esc to enter
{%- endcomment -%}

<script>
  /* Instant check to prevent flash on session return */
  (function() {
    try {
      if (sessionStorage.getItem('sv_curtain_seen') === '1') {
        document.documentElement.classList.add('sv-curtain-dismissed');
      }
    } catch (e) {}
  })();
</script>

{%- capture garment_urls -%}
[
  {{ 'rack-cutout-2.png' | asset_url | json }},
  {{ 'rack-cutout-4.png' | asset_url | json }},
  {{ 'rack-cutout-1.png' | asset_url | json }},
  {{ 'rack-cutout-3.png' | asset_url | json }},
  {{ 'rack-cutout-0.png' | asset_url | json }},
  {{ 'rack-cutout-7.png' | asset_url | json }}
]
{%- endcapture -%}

<aside
  id="sv-curtain-intro"
  class="curtain-intro"
  role="dialog"
  aria-modal="true"
  aria-label="Style Vibeus 3D Mağaza Girişi"
  tabindex="-1"
  data-garments="{{ garment_urls | strip | escape }}"
>
  <canvas id="sv-3d-walkthrough-canvas" class="curtain-3d-canvas"></canvas>

  <!-- Minimal HUD overlay: Skip button & subtle tap hint -->
  <div class="curtain-hud">
    <button
      type="button"
      id="sv-curtain-skip"
      class="curtain-skip"
      aria-label="Animasyonu Atla"
    >
      <span class="curtain-skip__text">Skip</span>
      <span class="curtain-skip__icon" aria-hidden="true">✕</span>
    </button>

    <div class="curtain-hud__bottom" aria-hidden="true">
      <div class="curtain-progress">
        <span class="curtain-progress__fill"></span>
      </div>
      <span class="curtain-hint__text">Hemen girmek için dokunun</span>
    </div>
  </div>
</aside>
