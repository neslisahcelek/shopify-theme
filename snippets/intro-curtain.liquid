{%- comment -%}
  Style Vibeus — Interactive 3D WebGL Boutique Walkthrough (Ultra-Premium)
  -------------------------------------------------------------
  - Pulls real products from collections.all for authentic titles, prices & product detail URLs
  - Pairs with transparent rack-cutout-*.png assets for clean 3D hanger presentation
  - Clicking/tapping any 3D garment navigates directly to its product detail page
{%- endcomment -%}

<script>
  /* Instant check to prevent flash on session return */
  (function() {
    try {
      if (sessionStorage.getItem('sv_curtain_seen') === '1') {
        document.documentElement.classList.add('sv-curtain-dismissed');
      }
    } catch (e) {}
  })();
</script>

{%- capture garment_items -%}
  {%- assign store_products = collections.all.products -%}
  {%- if store_products.size > 0 -%}
    [
    {%- for prod in store_products limit: 6 -%}
      {%- assign idx = forloop.index0 -%}
      {%- case idx -%}
        {%- when 0 -%}{%- assign cutout_asset = 'rack-cutout-0.png' | asset_url -%}
        {%- when 1 -%}{%- assign cutout_asset = 'rack-cutout-1.png' | asset_url -%}
        {%- when 2 -%}{%- assign cutout_asset = 'rack-cutout-2.png' | asset_url -%}
        {%- when 3 -%}{%- assign cutout_asset = 'rack-cutout-3.png' | asset_url -%}
        {%- when 4 -%}{%- assign cutout_asset = 'rack-cutout-4.png' | asset_url -%}
        {%- else -%}{%- assign cutout_asset = 'rack-cutout-7.png' | asset_url -%}
      {%- endcase -%}
      {
        "url": {{ cutout_asset | json }},
        "title": {{ prod.title | json }},
        "price": {{ prod.price | money | json }},
        "href": {{ prod.url | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]
  {%- else -%}
    [
      { "url": {{ 'rack-cutout-2.png' | asset_url | json }}, "title": "Butterfly Knit Sweater", "price": "$120", "href": {{ routes.all_products_collection_url | json }} },
      { "url": {{ 'rack-cutout-4.png' | asset_url | json }}, "title": "Atelier Heavyweight Jacket", "price": "$185", "href": {{ routes.all_products_collection_url | json }} },
      { "url": {{ 'rack-cutout-1.png' | asset_url | json }}, "title": "Graphic Essential Hoodie", "price": "$110", "href": {{ routes.all_products_collection_url | json }} },
      { "url": {{ 'rack-cutout-3.png' | asset_url | json }}, "title": "Boxy Street Hoodie", "price": "$95", "href": {{ routes.all_products_collection_url | json }} },
      { "url": {{ 'rack-cutout-0.png' | asset_url | json }}, "title": "Distressed Denim Shorts", "price": "$88", "href": {{ routes.all_products_collection_url | json }} },
      { "url": {{ 'rack-cutout-7.png' | asset_url | json }}, "title": "Everyday Minimal Tee", "price": "$55", "href": {{ routes.all_products_collection_url | json }} }
    ]
  {%- endif -%}
{%- endcapture -%}

<aside
  id="sv-curtain-intro"
  class="curtain-intro"
  role="dialog"
  aria-modal="true"
  aria-label="Style Vibeus 3D Virtual Boutique"
  tabindex="-1"
  data-garments="{{ garment_items | strip | escape }}"
>
  <canvas id="sv-3d-walkthrough-canvas" class="curtain-3d-canvas"></canvas>

  <!-- Interactive Store HUD -->
  <div class="curtain-hud">
    <!-- Top-right instant exit button -->
    <button
      type="button"
      id="sv-curtain-skip"
      class="curtain-skip"
      aria-label="Exit 3D Store and Enter Site"
    >
      <span class="curtain-skip__text">Enter Store</span>
      <span class="curtain-skip__icon" aria-hidden="true">✕</span>
    </button>

    <!-- Bottom status / product inspection / exploration bar -->
    <div class="curtain-hud__bottom">
      <!-- Floating Product Inspection Pill -->
      <a
        href="{{ routes.all_products_collection_url }}"
        id="sv-curtain-product-pill"
        class="curtain-product-pill"
        hidden
      >
        <span class="curtain-product-pill__dot" aria-hidden="true"></span>
        <span class="curtain-product-pill__title" data-pill-title></span>
        <span class="curtain-product-pill__price" data-pill-price></span>
        <span class="curtain-product-pill__cta">View Product →</span>
      </a>

      <!-- Entering progress (shown during 0-2.35s entrance) -->
      <div class="curtain-entering-pill" id="sv-curtain-entering">
        <div class="curtain-progress">
          <span class="curtain-progress__fill"></span>
        </div>
        <span class="curtain-hint__text">Entering boutique...</span>
      </div>

      <!-- Explore bar (shown once inside the store) -->
      <div class="curtain-explore-bar" id="sv-curtain-explore" hidden>
        <span class="curtain-explore-bar__hint">
          Scroll: Walk &nbsp;·&nbsp; Drag: Look Around &nbsp;·&nbsp; Click Product
        </span>
        <button type="button" id="sv-curtain-enter-shop" class="curtain-enter-btn">
          <span>Shop Now</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</aside>
