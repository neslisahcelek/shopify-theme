{%- comment -%}
  Usage: {% render 'price', product: product %} or {% render 'price', variant: variant %}
{%- endcomment -%}
{%- liquid
  if variant
    assign price = variant.price
    assign compare = variant.compare_at_price
    assign varies = false
  else
    assign price = product.price
    assign compare = product.compare_at_price
    assign varies = product.price_varies
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
  assign price_money = price | money
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  <span class="price__current">
    {%- if varies -%}{{ 'products.product.from_price' | t: price: price_money }}{%- else -%}{{ price_money }}{%- endif -%}
  </span>
  {%- if on_sale -%}
    <s class="price__compare">{{ compare | money }}</s>
    <span class="price__badge">-%{{ compare | minus: price | times: 100 | divided_by: compare }}</span>
  {%- endif -%}
</div>
