{%- comment -%}
  Open Graph / Twitter cards for link previews.
  Usage: {% render 'meta-tags', brand: brand, is_home: is_home, meta_description: meta_description %}
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: brand
  if is_home and settings.seo_home_title != blank
    assign og_title = settings.seo_home_title
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = meta_description | default: shop.description | default: brand | strip_html

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif

  assign og_image = page_image | default: settings.seo_share_image
-%}

<meta property="og:site_name" content="{{ brand | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ og_image.width }}">
  <meta property="og:image:height" content="{{ og_image.height }}">
{%- else -%}
  {%- comment -%} Built-in brand card for pages with no image of their own. {%- endcomment -%}
  <meta property="og:image" content="https:{{ 'og-default.jpg' | asset_url }}">
  <meta property="og:image:secure_url" content="https:{{ 'og-default.jpg' | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
